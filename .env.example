# ==================================================
# GreenAccess AI — Environment Configuration
# ==================================================

# Client-Side Configuration (Public — VITE_ prefix required)
# Toggle between 'demo' (synthetic baseline) or 'earth-engine' (remote server pipeline)
VITE_DATA_MODE=demo

# Base URL for backend analysis API (when running in Earth Engine mode)
VITE_EE_API_URL=/api

# Optional custom map tile provider
VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_ATTRIBUTION="&copy; OpenStreetMap contributors"

# ==================================================
# Server-Side Configuration (PROTECTED — NEVER COMMIT KEYS)
# Do NOT prefix with VITE_. Must reside only in backend/server environments.
# ==================================================
# EARTH_ENGINE_PROJECT=your-gcp-project-id
# EARTH_ENGINE_CLIENT_EMAIL=service-account@your-gcp-project.iam.gserviceaccount.com
# EARTH_ENGINE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
